<Window x:Class="KTGameBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KTGameBooster"
        Title="KT Game Booster v1.0" Height="820" Width="1280" MinHeight="700" MinWidth="1080"
        Background="Transparent" Foreground="{DynamicResource Fg0Brush}"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/ktgam.ico"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <local:LogColorConverter          x:Key="LogColor"/>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="bgFx" Grid.RowSpan="2" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle Fill="#32101014"/>
        </Grid>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentGradBrush}">
                        <TextBlock Text="KT" FontSize="8" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KT Game Booster" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="v1.0" Margin="8,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnThemeToggle" Style="{StaticResource BtnGhost}" Height="43" Width="Auto"
                            Padding="14,0" BorderThickness="0" Content="Tema: Escuro" FontSize="11"
                            Click="btnThemeToggle_Click"
                            ToolTip="Alternar tema (Preto / Escuro / Claro)"/>
                    <Button Content="—" Style="{StaticResource BtnGhost}" Width="46" Height="43" Padding="0"
                            BorderThickness="0" Click="TitleMinimize_Click"/>
                    <Button Content="□" Style="{StaticResource BtnGhost}" Width="46" Height="43" Padding="0"
                            BorderThickness="0" Click="TitleMaximize_Click"/>
                    <Button Content="×" Style="{StaticResource BtnWindowClose}" Width="46" Height="43" Padding="0"
                            BorderThickness="0" Click="btnQuit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="KT" FontWeight="Bold" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KT GAME" Style="{StaticResource Title}" FontSize="15"/>
                            <TextBlock Text="BOOSTER · v1.0" Style="{StaticResource Sub}" FontSize="10" Opacity="0.75"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="adminBadge" DockPanel.Dock="Top" Margin="20,0,20,8"
                        Background="{DynamicResource SuccessSubtleBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,6" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"
                              Data="M 6 1 L 11 4 L 11 9 L 6 12 L 1 9 L 1 4 Z M 6 4 L 4 6 L 5.5 7.5 L 4 9 L 6 9 L 8 7 L 6.5 5.5 Z"/>
                        <TextBlock Text="elevado (admin)" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="6,8">
                    <RadioButton x:Name="navDashboard" GroupName="nav" IsChecked="True" Tag="Dashboard"
                                 Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Dashboard">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navTweaks" GroupName="nav"
                                 Tag="Tweaks" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Tweaks">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Tweaks" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navProcesses" GroupName="nav"
                                 Tag="Processos" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Processos">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Processos" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navGovernor" GroupName="nav"
                                 Tag="Governor" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Governor">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Governor" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navServices" GroupName="nav"
                                 Tag="Servicos" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Serviços">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Serviços" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navBench" GroupName="nav"
                                 Tag="Bench" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Bench">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Bench" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navGames" GroupName="nav"
                                 Tag="Jogos" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Jogos">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Jogos" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navAbout" GroupName="nav"
                                 Tag="Sobre" Checked="Nav_Changed" Style="{StaticResource NavItem}" ToolTip="Sobre">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22"/><TextBlock Text="Sobre" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border x:Name="extremeBanner" DockPanel.Dock="Bottom" Margin="12,0,12,12"
                        Background="{DynamicResource DangerSubtleBrush}" BorderBrush="{DynamicResource DangerStrongBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="RECUPERAÇÃO DE SHELL PENDENTE" FontWeight="Bold" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Uma sessão anterior pode ter deixado processos do shell suspensos." FontSize="10" Foreground="White"
                                   Opacity="0.85" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <Button x:Name="btnPanic" Content="RESTAURAR SHELL (pânico)" Style="{StaticResource BtnPanic}"
                                Margin="0,8,0,0" Click="btnPanic_Click"
                                ToolTip="Reverte o modo extremo a qualquer momento"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg2Brush}" Margin="12,0,12,12" Padding="12,10"
                        CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="backdropDot" Width="7" Height="7" Fill="{DynamicResource Fg2Brush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtBackdropStatus" Text="material: verificando" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="connDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtConnLabel" Text="motor" Style="{StaticResource Sub}" FontSize="12"/>
                            <Border x:Name="adminMiniDot" Width="6" Height="6" CornerRadius="3" Margin="8,0,0,0"
                                    Background="{DynamicResource SuccessBrush}"
                                    ToolTip="Host em modo elevado (admin)"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="txtStatus" Text="conectando..." Style="{StaticResource Sub}" FontSize="11"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtExtremeStatus" Text="" Style="{StaticResource Muted}" FontSize="10"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtEngineHint" Text="" Style="{StaticResource Muted}" FontSize="10"
                                   Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Button x:Name="btnRecoverEngine" Content="Tentar recuperação" Style="{StaticResource BtnGhost}"
                                Margin="0,8,0,0" Padding="8,6" Visibility="Collapsed"
                                Click="btnRecoverEngine_Click" ToolTip="Tenta restaurar a sessão pendente sem aplicar novos ajustes"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="0,0,14,14" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="txtPageTitle" Text="Dashboard" Style="{StaticResource Title}" FontSize="18"/>
                        <TextBlock x:Name="txtPageSub" Text="visão geral do motor e do jogo ativo" Style="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource GlassChip}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent3Brush}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="txtMaterialChip" Text="MICA" Style="{StaticResource Sub}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="profileChip" Background="{DynamicResource Bg3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="12,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtActiveProfile" Text="perfil: normal" Style="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnTopPause" Content="Pausar" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                                Click="btnPause_Click" ToolTip="Pausar/retomar motor (Ctrl+Shift+P)"/>
                        <Button x:Name="btnTopStart" Content="Iniciar" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0"
                                Click="btnStart_Click" ToolTip="Liga/desliga o motor (Ctrl+Shift+O)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="pageDashboard" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="22,18,22,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="infoBarDashboard" Grid.Row="0" Style="{StaticResource InfoBarWarning}"
                            Visibility="Collapsed" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource InfoBarIcon}" Foreground="{DynamicResource WarnBrush}"/>
                            <TextBlock x:Name="infoBarDashboardMsg" Grid.Column="1" Style="{StaticResource InfoBarMessage}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelHero}" Padding="22,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="JOGO ATIVO" Style="{StaticResource SectionHeader}"/>
                                    <Border x:Name="confBadge" Margin="10,0,0,0" CornerRadius="9" Padding="8,3" Background="{DynamicResource Bg3Brush}" Visibility="Collapsed">
                                        <TextBlock x:Name="txtConfidence" Text="" Style="{StaticResource Sub}" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="txtGame" Style="{StaticResource MetricBig}" FontSize="30" Text="aguardando..." Margin="0,6,0,0"/>
                                <TextBlock x:Name="txtGameDetail" Style="{StaticResource Sub}" Text="motor " Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtFps" Style="{StaticResource Sub}" Text="" Margin="0,4,0,0"
                                           ToolTip="FPS medido via Present/ETW. P95 é o percentil 95 do tempo de frame; 1% low é derivado do P99."/>
                                <TextBlock x:Name="txtGpu" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"
                                           Text="GPU: aguardando telemetria" TextTrimming="CharacterEllipsis"
                                           ToolTip="Utilização agregada dos motores de GPU detectados pelo Windows."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="engineStateChip" Style="{StaticResource StatusChip}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="engineStateDot" Width="7" Height="7" Fill="{DynamicResource WarnBrush}"
                                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtEngineState" Text="MOTOR PARADO" Style="{StaticResource Sub}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="acChip" Style="{StaticResource StatusChip}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                        Background="{DynamicResource WarnSubtleBrush}" BorderBrush="{DynamicResource WarnBorderBrush}"
                                        Visibility="Collapsed"
                                        ToolTip="Anti-cheat detectado: a sessão roda sem suspensão de processos/threads, sem pausa de serviços e sem limitador de fundo — só levers user-mode que não acionam o anticheat.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txtAcChip" Text="ANTICHEAT · MODO SEGURO" Style="{StaticResource Sub}"
                                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="presetChip" Style="{StaticResource StatusChip}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                        Background="{DynamicResource Bg3Brush}"
                                        Visibility="Collapsed"
                                        ToolTip="Preset automático aplicado ao título desta sessão (bloco [[process]] do gamemode.toml, auto-perfil ou perfil streaming com app de captura ativo). Vazio = perfil global escolhido por você.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txtPresetChip" Text="PRESET AUTOMÁTICO" Style="{StaticResource Sub}"
                                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button x:Name="btnTournament" Content="FPS Máximo" Margin="0,0,6,0"
                                            Click="btnTournament_Click"
                                            ToolTip="FPS Máximo: prioridade Alta, MMCSS, memória e I/O do jogo; sem Realtime"/>
                                    <Button x:Name="btnCleanRam" Content="Limpar RAM" Style="{StaticResource BtnPrimary}" Click="btnCleanRam_Click"
                                            ToolTip="Trim do working set (Ctrl+Shift+M)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelHoverable}" Margin="0,0,10,0" Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CPU" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="  ·  pico" Style="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="txtPeakCpu" Text="·" Style="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="txtCpu" Style="{StaticResource MetricBig}" FontSize="30" Text="0%"/>
                                <ProgressBar x:Name="cpuBar" Value="0" Maximum="100" Margin="0,10,0,0" Style="{StaticResource CpuBarStyle}"
                                             AutomationProperties.Name="Uso de CPU atual"/>
                                <local:Sparkline x:Name="sparkCpu" Height="32" Margin="0,8,0,0"
                                                 AutomationProperties.Name="Histórico de CPU nas últimas amostras"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelHoverable}" Margin="0,0,10,0" Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RAM" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="  ·  pico" Style="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="txtPeakRam" Text="·" Style="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="txtRam" Style="{StaticResource MetricBig}" FontSize="30" Text="0 GB"/>
                                <ProgressBar x:Name="ramBar" Value="0" Maximum="100" Margin="0,10,0,0" Style="{StaticResource RamBarStyle}"
                                             AutomationProperties.Name="Uso de memória atual"/>
                                <local:Sparkline x:Name="sparkRam" Height="32" Margin="0,8,0,0"
                                                 AutomationProperties.Name="Histórico de memória nas últimas amostras"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelHoverable}" Margin="0,0,10,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="LIMITADOS" Style="{StaticResource SectionHeader}"/>
                                <TextBlock x:Name="txtBg" Style="{StaticResource MetricBig}" FontSize="30" Text="0" Foreground="{DynamicResource WarnBrush}"/>
                                <TextBlock Text="processos de fundo em EcoQoS" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource PanelHoverable}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="BOOSTS / LIMPEZAS" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="helpers:" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="txtHelpers" Text="0" Style="{StaticResource MetricMid}" Margin="6,0,0,0" Foreground="{DynamicResource Accent3Brush}"/>
                                </StackPanel>
                                <TextBlock x:Name="txtSvcPause" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="AÇÃO RÁPIDA" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="perfil" Style="{StaticResource Sub}" Margin="0,10,0,4"/>
                                <ComboBox x:Name="cmbProfile" SelectedIndex="0" SelectionChanged="cmbProfile_Changed" Style="{StaticResource DarkCombo}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="chkAutoProfile" Content="Auto-perfil" Tag="auto_profile_switching" Style="{StaticResource TweakToggle}"
                                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                </StackPanel>
                                <CheckBox x:Name="chkAcSafe" Content="Sequência segura p/ anticheat" Tag="anticheat_safe_mode" Style="{StaticResource TweakToggle}"
                                          Margin="0,6,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                          ToolTip="Quando um jogo com anti-cheat (Valorant, Fortnite, CoD, PUBG, Apex, cs2...) for detectado, a sessão desliga automaticamente suspensão de threads/processos, pausa de serviços e limitador de fundo — nada que o anticheat possa sinalizar. Prioridade/afinidade/MMCSS continuam."/>
                                <CheckBox x:Name="chkSafeMode" Content="Modo seguro (somente diagnóstico)" Style="{StaticResource TweakToggle}"
                                          Margin="0,6,0,0" Checked="SafeMode_Changed" Unchecked="SafeMode_Changed"
                                          ToolTip="Restaura uma sessão pendente e bloqueia todos os tweaks até você desmarcar esta opção."/>

                                <CheckBox x:Name="chkAutoRun" Content="Iniciar com o Windows (bandeja)" Style="{StaticResource TweakToggle}"
                                          Margin="0,2,0,0" Checked="AutoRun_Changed" Unchecked="AutoRun_Changed"
                                          ToolTip="Registra o app no HKCU Run para abrir junto com o Windows, já minimizado na bandeja. Reversível aqui ou pelo Gerenciador de Tarefas."/>

                                <CheckBox x:Name="chkHideOnGame" Content="Modo jogo: painel leve na bandeja" Style="{StaticResource TweakToggle}"
                                          Margin="0,6,9,0" Checked="HideOnGame_Changed" Unchecked="HideOnGame_Changed"
                                          ToolTip="Quando um jogo é detectado, o painel entra em modo econômico (animações e sombras desligadas) e some para a bandeja — a otimização continua. A janela volta quando você clica no ícone da bandeja."/>

                                <TextBlock Text="otimizar um .exe agora" Style="{StaticResource Sub}" Margin="0,14,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtTestTarget" Text=""
                                             ToolTip="Nome do .exe para testar como jogo; ou selecione um processo na página Processos."/>
                                    <Button x:Name="btnTestTarget" Grid.Column="1" Content="Testar" Margin="8,0,0,0" Click="btnTestTarget_Click"
                                            ToolTip="Força o motor a otimizar este processo como se fosse um jogo"/>
                                </Grid>

                                <Separator Margin="0,14,0,10"/>
                                <TextBlock Text="HOTKEYS GLOBAIS" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Ctrl+Shift+O" Style="{StaticResource Muted}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="liga/desliga motor" Style="{StaticResource Muted}" Margin="10,0,0,0"/>
