                                                      ToolTip="Reduz a prioridade de disco (I/O) dos processos em segundo plano."
                                                      AutomationProperties.Name="I/O baixa fundo"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Liberar RAM do fundo" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Faz trim da memória dos processos em segundo plano." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkTrimWs" Grid.Column="1" Tag="trim_background_ws"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Faz trim do working set dos processos em segundo plano para liberar RAM."
                                                      AutomationProperties.Name="Liberar RAM do fundo"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Boost nos helpers do jogo" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Eleva a prioridade dos helpers do processo do jogo." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkTreeBoost" Grid.Column="1" Tag="game_tree_boost"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Eleva a prioridade dos processos filhos/helpers do jogo."
                                                      AutomationProperties.Name="Boost nos helpers do jogo"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Otimizar serviços opcionais" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Pausa serviços não críticos durante o jogo." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkSvcGaming" Grid.Column="1" Tag="pause_services_gaming"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Pausa quando possível; caso contrário para. Restaura automaticamente ao fim do jogo."
                                                      AutomationProperties.Name="Otimizar serviços opcionais"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource TweakCard}">
                                <StackPanel>
                                    <TextBlock Text="LATÊNCIA AVANÇADA" Style="{StaticResource SectionHeader}" Foreground="{DynamicResource Accent3Brush}"/>
                                    <TextBlock Text="Ajustes extras da engine para reduzir filas e priorizar o caminho crítico do jogo."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Prioridade das threads do DWM" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Ajusta a prioridade das threads do compositor." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkDwmThread" Grid.Column="1" Tag="dwm_thread_priority"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Ajusta a prioridade das threads do Desktop Window Manager para o caminho de composição."
                                                      AutomationProperties.Name="Prioridade das threads do DWM"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Power throttling em segundo plano" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Força power throttling no que estiver em segundo plano." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkBgPowerThrottle" Grid.Column="1" Tag="thread_power_background_throttle"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Força power throttling nas threads dos processos em segundo plano."
                                                      AutomationProperties.Name="Power throttling em segundo plano"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="I/O alta para o jogo" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Sobe a prioridade de disco do processo do jogo." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkIoGameHigh" Grid.Column="1" Tag="io_priority_game_high"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Sobe a prioridade de disco (I/O) do processo do jogo para Alta."
                                                      AutomationProperties.Name="I/O alta para o jogo"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="MMCSS nas threads do jogo" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Registra as threads do jogo no MMCSS." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkMmcssGame" Grid.Column="1" Tag="mmcss_game"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Registra as threads do processo do jogo no esquema MMCSS."
                                                      AutomationProperties.Name="MMCSS nas threads do jogo"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Prioridade de páginas do jogo" Style="{StaticResource SettingCardTitle}"/>
                                                <TextBlock Text="Prioriza a memória de página do processo do jogo." Style="{StaticResource SettingCardDesc}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkPageGame" Grid.Column="1" Tag="page_priority_game"
                                                      Style="{StaticResource SettingToggle}"
                                                      ToolTip="Define a prioridade de memória de página do processo do jogo como Alta."
                                                      AutomationProperties.Name="Prioridade de páginas do jogo"
                                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="pageProcesses" Grid.Row="1" Visibility="Collapsed" Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PROCESSOS DO SISTEMA" Style="{StaticResource Title}" FontSize="18"/>
                        <TextBlock x:Name="txtProcCount" Text="" Style="{StaticResource Muted}" Margin="10,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="txtProcFilter" Width="220" TextChanged="txtProcFilter_TextChanged"
                             ToolTip="Filtrar por nome (ex.: chrome, spotify, cs2)"/>
                    <Button x:Name="btnBoostTarget" Content="Otimizar como jogo" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                            Click="btnBoostTarget_Click"
                            ToolTip="Força o motor a tratar o processo selecionado como jogo (boost completo)"/>
                    <Button x:Name="btnExcludeProc" Content="Excluir do limitador" Margin="8,0,0,0"
                            Click="btnExcludeProc_Click"
                            ToolTip="Nunca limitar este processo (ex.: Spotify/Discord)"/>
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="6">
                    <ListView x:Name="lstProcs">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding cpuStr}">
                                    <GridViewColumnHeader Content="CPU" Tag="cpuPct" Click="ProcCol_Click"/>
                                </GridViewColumn>
                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding ramStr}">
                                    <GridViewColumnHeader Content="RAM" Tag="ramMB" Click="ProcCol_Click"/>
                                </GridViewColumn>
                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding pid}">
                                    <GridViewColumnHeader Content="PID" Tag="pidNum" Click="ProcCol_Click"/>
                                </GridViewColumn>
                                <GridViewColumn Width="280">
                                    <GridViewColumnHeader Content="Nome" Tag="name" Click="ProcCol_Click"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="22" Height="22" Margin="0,0,8,0">
                                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Image Source="{Binding icon}" Width="20" Height="20" Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                                <TextBlock Text="{Binding name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100" DisplayMemberBinding="{Binding klass}">
                                    <GridViewColumnHeader Content="Classe" Tag="klass" Click="ProcCol_Click"/>
                                </GridViewColumn>
                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding stateStr}">
                                    <GridViewColumnHeader Content="Estado" Tag="stateStr" Click="ProcCol_Click"/>
                                </GridViewColumn>
                                <GridViewColumn Width="120">
                                    <GridViewColumnHeader Content="Afinidade"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding affinityHex}" FontFamily="Consolas"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <Grid x:Name="pageGovernor" Grid.Row="1" Visibility="Collapsed" Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PROCESS GOVERNOR" Style="{StaticResource Title}" FontSize="18"/>
                        <TextBlock Text="automático no jogo detectado, com controles manuais opcionais e restauração segura"
                                   Style="{StaticResource Sub}"/>
                    </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="txtGovCount" Text="0 processos visíveis" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Style="{StaticResource GlassChip}" Margin="0,0,8,0">
                            <TextBlock x:Name="txtGovAutoStatus" Text="AUTO · MONITORANDO"
                                       Foreground="{DynamicResource Accent3Brush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource GlassChip}">
                            <TextBlock Text="PROCESSOS CRÍTICOS PROTEGIDOS" Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource Panel}" Margin="0,0,8,0" Padding="14,11">
                        <StackPanel><TextBlock Text="SELECIONADO" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtGovSelected" Text="nenhum" Style="{StaticResource MetricMid}" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,8,0" Padding="14,11">
                        <StackPanel><TextBlock Text="CPU" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtGovCpu" Text="—" Style="{StaticResource MetricMid}" Foreground="{DynamicResource Accent3Brush}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,8,0" Padding="14,11">
                        <StackPanel><TextBlock Text="MEMÓRIA" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtGovRam" Text="—" Style="{StaticResource MetricMid}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="14,11">
                        <StackPanel><TextBlock Text="AFINIDADE" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtGovAffinity" Text="—" Style="{StaticResource MetricMid}" FontFamily="Consolas"/></StackPanel>
                    </Border>
                </UniformGrid>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource BorderHiBrush}">
                        <TextBlock x:Name="txtGovAutoDetail" Style="{StaticResource Sub}" TextWrapping="Wrap"
                                   Text="No modo automático, o motor acompanha o jogo e restaura as alterações da sessão ao terminar. Os controles manuais abaixo afetam somente o processo selecionado e permanecem até você alterá-los ou o processo encerrar."/>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Perfil:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ComboBox x:Name="cmbGovernorProfile" SelectedIndex="1" Style="{StaticResource DarkCombo}" MinWidth="130">
                                    <ComboBoxItem Content="Eficiência"/>
                                    <ComboBoxItem Content="Equilibrado"/>
                                    <ComboBoxItem Content="Performance"/>
                                </ComboBox>
                                <Button x:Name="btnGovernorProfileApply" Content="Aplicar perfil" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                        Click="btnGovernorProfile_Click"/>
                            </StackPanel>
                            <TextBox x:Name="txtGovernorFilter" Width="360" HorizontalAlignment="Left"
                                      TextChanged="txtGovernorFilter_TextChanged" ToolTip="Filtrar processos"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <ComboBox x:Name="cmbGovPriority" SelectedIndex="2" Style="{StaticResource DarkCombo}" MinWidth="115" Margin="0,0,7,0">
                                <ComboBoxItem Content="Idle"/><ComboBoxItem Content="Abaixo normal"/><ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Acima normal"/><ComboBoxItem Content="Alta"/>
                            </ComboBox>
                            <ComboBox x:Name="cmbGovIo" SelectedIndex="2" Style="{StaticResource DarkCombo}" MinWidth="95" Margin="0,0,7,0">
                                <ComboBoxItem Content="I/O idle"/><ComboBoxItem Content="I/O baixa"/><ComboBoxItem Content="I/O normal"/><ComboBoxItem Content="I/O alta"/>
                            </ComboBox>
                            <ComboBox x:Name="cmbGovMemory" SelectedIndex="1" Style="{StaticResource DarkCombo}" MinWidth="110" Margin="0,0,7,0">
                                <ComboBoxItem Content="Mem. baixa"/><ComboBoxItem Content="Mem. normal"/><ComboBoxItem Content="Mem. alta"/>
                            </ComboBox>
                            <CheckBox x:Name="chkGovEco" Content="EcoQoS" Style="{StaticResource TweakToggle}" Margin="4,5,12,0"
                                      ToolTip="Marca o processo para eficiência de energia (EcoQoS); desmarque para performance plena."/>
                            <Button x:Name="btnGovernorApply" Content="Aplicar" Click="btnGovernorAdvanced_Click" Margin="0,0,7,0"
                                    ToolTip="Aplica prioridade, EcoQoS, I/O e memória ao processo selecionado"/>
                            <Button x:Name="btnGovernorSuspend" Content="Suspender" Click="btnGovernorSuspend_Click" Margin="0,0,7,0"
                                    ToolTip="Congela o processo selecionado até você clicar Retomar (ou o processo encerrar). Pede confirmação."/>
                            <Button x:Name="btnGovernorResume" Content="Retomar" Click="btnGovernorResume_Click" Margin="0,0,7,0"
                                    ToolTip="Retoma um processo suspenso pelo botão acima (o motor também retoma automaticamente ao encerrar)."/>
                            <Button x:Name="btnGovernorTrim" Content="Trim RAM" Click="btnGovernorTrim_Click"
                                    ToolTip="Libera memória em standby deste processo (working set)"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="6">
                    <ListView x:Name="lstGovernor" SelectionChanged="lstGovernor_SelectionChanged" AlternationCount="2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedItemBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Processo" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="22" Height="22" Margin="0,0,8,0">
                                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Image Source="{Binding icon}" Width="20" Height="20" Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                                <TextBlock Text="{Binding name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="PID" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding pid}" FontFamily="Consolas"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CPU" Width="70" DisplayMemberBinding="{Binding cpuStr}"/>
                                <GridViewColumn Header="RAM" Width="80" DisplayMemberBinding="{Binding ramStr}"/>
                                <GridViewColumn Header="Prioridade" Width="125" DisplayMemberBinding="{Binding klass}"/>
                                <GridViewColumn Header="Afinidade" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding affinityHex}" FontFamily="Consolas"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Estado" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleOverlayBrush}" BorderBrush="{Binding stateBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding stateStr}" Foreground="{Binding stateBrush}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <Grid x:Name="pageServices" Grid.Row="1" Visibility="Collapsed" Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="SERVIÇOS &amp; OTIMIZAÇÃO" Style="{StaticResource Title}" FontSize="18"/>
                    <TextBlock x:Name="txtSvcCount" Text="Carregando serviços..." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16,13" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource GlassChip}" Padding="8,3" Margin="0,0,9,0">
                                    <TextBlock Text="AUTO-RESTORE" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="Serviços opcionais durante o jogo" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtSvcPlanSummary"
                                       Text="A lista abaixo mostra exatamente o que será pausado ou parado. Nada crítico é alterado."
                                       Style="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="chkSvcAuto" Grid.Column="1" Content="Ativar no jogo" Tag="pause_services_gaming"
                                  Style="{StaticResource TweakToggle}" Margin="18,0,0,0" VerticalAlignment="Center"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                  ToolTip="Aplica somente aos alvos marcados como PAUSAR/PARAR e restaura no fim da sessão."/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="txtSvcFilter" Width="190" TextChanged="txtSvcFilter_TextChanged"
                             ToolTip="Filtrar por nome/descrição"/>
                    <ComboBox x:Name="cmbSvcState" SelectedIndex="0" SelectionChanged="cmbSvcState_Changed" Margin="8,0,0,0"
                              Style="{StaticResource DarkCombo}" MinWidth="175">
                        <ComboBoxItem Content="alvos da otimização"/>
                        <ComboBoxItem Content="ativos + pausados"/>
                        <ComboBoxItem Content="todos"/>
                    </ComboBox>
                    <Button x:Name="btnSvcStop" Content="Parar" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                            Click="btnSvcStop_Click"
                            ToolTip="Para o serviço selecionado (modo manual; o modo automático só restaura o que ele alterar)"/>
                    <Button x:Name="btnSvcPause" Content="Pausar / retomar" Margin="6,0,0,0"
                            Click="btnSvcPause_Click" ToolTip="Pausa o serviço; clique de novo para retomar"/>
                    <Button x:Name="btnSvcStart" Content="Iniciar" Style="{StaticResource BtnPrimary}" Margin="6,0,0,0"
                            Click="btnSvcStart_Click" ToolTip="Inicia um serviço parado"/>
                </StackPanel>
                <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="6">
                    <ListView x:Name="lstServices" SelectionChanged="lstServices_SelectionChanged" AlternationCount="2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedItemBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Serviço" Width="155">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding planBrush}" Margin="2,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Descrição" Width="225">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding display}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Plano" Width="105">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleOverlayBrush}" BorderBrush="{Binding planBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding planStr}" Foreground="{Binding planBrush}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Por que otimizar" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding reasonStr}" Foreground="{DynamicResource Fg1Brush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding reasonStr}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Estado" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding stateStr}" Foreground="{Binding stateBrush}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding pid}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <Grid x:Name="pageBench" Grid.Row="1" Visibility="Collapsed" Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="BENCH DE LATÊNCIA" Style="{StaticResource Title}" FontSize="18"/>
                    <TextBlock Style="{StaticResource Sub}" Text="mede a latência real do seu sistema: resolução do timer, jitter de scheduling e I/O em SSD sem cache — score composto 0-100. Rode ANTES e DEPOIS de mudar tweaks."/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="duração:" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbBenchDur" SelectedIndex="1" Margin="8,0,0,0"
                                          Style="{StaticResource DarkCombo}" MinWidth="100">
                                    <ComboBoxItem Content="rápido (1s)"/>
                                    <ComboBoxItem Content="normal (1.5s)"/>
                                    <ComboBoxItem Content="longo (3s)"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="txtBenchStatus" Text="Pronto." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnExportTelemetry" Content="Exportar JSON/CSV" Style="{StaticResource BtnGhost}"
                                    Click="btnExportTelemetry_Click" Margin="0,0,8,0"
                                    ToolTip="Exporta somente dados locais; nada é enviado automaticamente"/>
                            <Button x:Name="btnRunBench" Content="Rodar bench" Style="{StaticResource BtnPrimary}"
                                    Click="btnRunBench_Click"
                                    ToolTip="(Ctrl+Shift+B) Mede resolução do timer, scheduling e I/O"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="22,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SCORE" Style="{StaticResource SectionHeader}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="txtBenchScore" Style="{StaticResource MetricBig}" FontSize="26" Text="·" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtBenchScoreSub" Text="composto 0-100" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TIMER" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtBenchTimer" Style="{StaticResource MetricBig}" FontSize="26" Text="·" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtBenchTimerSub" Text="resolução real do timer" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SCHED P95" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtBenchP95" Style="{StaticResource MetricBig}" FontSize="26" Text="·" Margin="0,4,0,0"/>
                            <TextBlock Text="jitter de scheduling" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="I/O P95" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtBenchIo" Style="{StaticResource MetricBig}" FontSize="26" Text="·" Margin="0,4,0,0"/>
                            <TextBlock Text="SSD 4KB sem cache" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="PICO" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="txtBenchMax" Style="{StaticResource MetricBig}" FontSize="26" Text="·" Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="pior caso" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="22,16" MinHeight="210">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="HISTÓRICO DE P95 (SCHEDULER)" Style="{StaticResource SectionHeader}" Foreground="{DynamicResource Accent3Brush}"/>
                                <TextBlock Text="latência por execução · menor é melhor" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtBenchRuns" Text="0 execuções" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,8">
                            <local:Sparkline x:Name="sparkBench" Stroke="{DynamicResource Accent3Brush}"/>
                            <TextBlock x:Name="txtBenchEmpty" Text="Rode o bench para começar o histórico"
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="txtBenchBest" Text="melhor: —" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="txtBenchTrend" Text="tendência: —" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtBenchWorst" Text="pior: —" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="txtBenchAB" Grid.Row="3" Text="A/B de sessão: rode um bench fora do jogo primeiro (vira baseline)"
                                   Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   ToolTip="P95 medido fora de sessão de jogo (baseline) contra o P95 medido com o jogo otimizado rodando. O baseline se atualiza a cada novo bench fora de sessão."/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="pageGames" Grid.Row="1" Visibility="Collapsed" Margin="22,18,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="JOGOS &amp; EXCEÇÕES" Style="{StaticResource Title}" FontSize="18"/>
                    <TextBlock Text="jogos detectados automaticamente (50+ embutidos) · exceções nunca são limitadas"
                               Style="{StaticResource Sub}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="JOGOS ADICIONADOS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                            <ListBox x:Name="lstGames" FontFamily="Consolas" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="ADICIONAR JOGO" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="nome do .exe (ex.: meujogo.exe)" Style="{StaticResource Muted}" Margin="0,6,0,6"/>
                                <TextBox x:Name="txtAddGame"/>
                                <Button x:Name="btnAddGame" Content="Adicionar" Style="{StaticResource BtnPrimary}" Margin="0,10,0,0" Click="btnAddGame_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="EXCEÇÕES DO LIMITADOR" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="processos que continuam normais durante o jogo (Spotify, Discord, OBS)"
                                           Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBox x:Name="txtAddExclusion"/>
                                <Button x:Name="btnAddExclusion" Content="Excluir processo" Style="{StaticResource BtnPrimary}" Margin="0,8,0,0"
                                        Click="btnAddExclusion_Click"/>
                                <TextBlock Text="excluídos agora:" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
                                <ListBox x:Name="lstExclusions" MaxHeight="160" FontFamily="Consolas" FontSize="11.5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="6,1" Margin="8,0,0,0"
                                                        Click="btnRemoveExclusion_Click" Tag="{Binding}"
                                                        AutomationProperties.Name="Remover exceção"
                                                        ToolTip="Remove da lista de exceções"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="pageAbout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,22">
                    <TextBlock Text="SOBRE" Style="{StaticResource Title}" FontSize="18"/>
                    <TextBlock x:Name="txtAboutLine" Text="KT Game Booster v1.0 · por kelvenapk" Style="{StaticResource Sub}" Margin="0,2,0,14"/>
                    <Border Style="{StaticResource Panel}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Otimizador de FPS para jogos no Windows · engine C++ nativa embarcada + UI WPF in-proc."
                                       Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            <TextBlock Height="10"/>
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                                       Text="O motor C++ (ktengine.dll) vive dentro do EXE da UI e roda in-proc · sem named pipe, sem processo de fundo. A detecção de jogos usa ETW com fallback para polling, e todos os tweaks têm restauração garantida ao encerrar: prioridades, afinidades, planos de energia, timer de sistema e o shell do Windows no modo extremo."/>
                            <TextBlock Height="14"/>
                            <TextBlock Text="Avisos" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Opacity="0.8"
                                       Text="• O app não encerra Explorer/DWM nem suspende winlogon; journals antigos ainda podem ser recuperados.&#10;• Algumas operações de prioridade e serviço dependem das permissões do processo.&#10;• Projeto por kelvenapk · github.com/kelvenapk."/>
                            <Button Content="GitHub · kelvenapk" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                    Margin="0,18,0,0" Click="btnGitHub_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderHiBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ATUALIZAÇÕES AUTOMÁTICAS" Style="{StaticResource SectionHeader}"/>
                                <TextBlock x:Name="txtUpdateStatus" Text="GitHub · aguardando verificação"
                                           Style="{StaticResource Sub}" Margin="0,5,14,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtUpdateChannel" Text="canal: verificando"
                                           Style="{StaticResource Muted}" Margin="0,4,14,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Verificar agora" Click="btnCheckUpdate_Click" Margin="0,0,8,0"/>
                                <Button x:Name="btnInstallUpdate" Content="Reiniciar e instalar" Style="{StaticResource BtnPrimary}"
                                        Visibility="Collapsed" Click="btnInstallUpdate_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
